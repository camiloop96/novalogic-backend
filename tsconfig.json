{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "paths": {
      "@common/*": ["common/*"],
      "@config/*": ["config/*"],
      "@database/*": ["database/*"],
      "@customers/*": ["modules/customers/*"],
      "@deliveries/*": ["modules/deliveries/*"],
      "@logistics/*": ["modules/logistics/*"],
      "@orders/*": ["modules/orders/*"],
      "@payments/*": ["modules/payments/*"],
      "@products/*": ["modules/products/*"],
      "@security/*": ["modules/security/*"],
      "@shipping/*": ["modules/shipping/*"],
      "@inventory/*": ["modules/inventory/*"],
      "@stats/*": ["modules/stats/*"],
      "@stores/*": ["modules/stores/*"],
      "@tenant/*": ["modules/tenant/*"],
      "@users/*": ["modules/users/*"]
    },
    "outDir": "./dist"
  }
}
